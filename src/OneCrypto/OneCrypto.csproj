<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Cryptography (not cryptocurrency) for .NET on the base class library alone: ASN.1, CMS, RFC 3161 time-stamps, X.509 and the cryptographic primitives the platform lacks. A clean-room alternative to BouncyCastle for formats and protocols. Unaffiliated with other products named OneCrypto.</Description>
    <PackageTags>cryptography;asn1;cms;pkcs7;rfc3161;timestamp;x509;pkcs8;pkcs12;ed25519;x25519;nativeaot;trimmable;bouncycastle;alternative</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Tests" />
    <InternalsVisibleTo Include="$(LibName).Benchmarks" />
    <InternalsVisibleTo Include="$(LibName).AotSmoke" />
    <InternalsVisibleTo Include="$(LibName).WasmSmoke" />
    <InternalsVisibleTo Include="$(LibName).Fuzz" />
    <InternalsVisibleTo Include="$(LibName).Timing" />
  </ItemGroup>

</Project>
