<Project Sdk="Microsoft.NET.Sdk">

  <!-- Statistical constant-time tests in the style of Reparaz, Balasch and Verbauwhede, "Dude, is my code constant time?" (DATE 2017).
       Run on a quiet machine under full-opt JIT; see docs/timing.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Timing</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneCrypto/OneCrypto.csproj" />
    <ProjectReference Include="../../src/OneCrypto.OpenPgp/OneCrypto.OpenPgp.csproj" />
  </ItemGroup>

</Project>
