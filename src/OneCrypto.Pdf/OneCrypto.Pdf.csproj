<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>PAdES signing (B-B to B-LTA), validation data and document time-stamps, and PDF signature validation with the OneCrypto path validator, on OnePDF. Cryptography (not cryptocurrency); unaffiliated with other products named OneCrypto.</Description>
    <PackageTags>pdf;pades;cades;rfc3161;timestamp;signature;ltv;nativeaot;trimmable</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Pdf.Tests" />
    <InternalsVisibleTo Include="$(LibName).AotSmoke" />
    <InternalsVisibleTo Include="$(LibName).Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneCrypto/OneCrypto.csproj" />
    <PackageReference Include="RecursiveAI.OnePdf" />
  </ItemGroup>

</Project>
