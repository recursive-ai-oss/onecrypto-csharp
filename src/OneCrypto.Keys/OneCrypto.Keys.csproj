<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageValidationBaselineVersion>0.4.0-preview.1</PackageValidationBaselineVersion>
    <Description>Key backends for OneCrypto: PKCS #11 tokens, gpg-agent (Assuan) and ssh-agent, behind the OneCrypto key interfaces with two-phase signing. Cryptography (not cryptocurrency); unaffiliated with other products named OneCrypto.</Description>
    <PackageTags>cryptography;pkcs11;gpg-agent;ssh-agent;assuan;hsm;softhsm;remote-signing;nativeaot;trimmable</PackageTags>
    <!-- Only the PKCS #11 function-pointer calls into a token module use unsafe code (Pkcs11/NativeModule.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Keys.Tests" />
    <InternalsVisibleTo Include="$(LibName).AotSmoke" />
    <InternalsVisibleTo Include="$(LibName).Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneCrypto/OneCrypto.csproj" />
  </ItemGroup>

</Project>
