<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds signatures with a test CA, signer and time-stamp authority, so the smoke can verify a real signature. -->
    <Compile Include="../OneCrypto.Tests/Support/SigKit.cs" Link="Support/SigKit.cs" />
    <Compile Include="../OneCrypto.Tests/Support/CmsFixture.cs" Link="Support/CmsFixture.cs" />
    <Compile Include="../OneCrypto.Tests/Support/CmsKeys.cs" Link="Support/CmsKeys.cs" />
    <Compile Include="../OneCrypto.Tests/Support/RecipientKit.cs" Link="Support/RecipientKit.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Common/FallbackSmoke.cs" Link="FallbackSmoke.cs" />
    <Compile Include="../Common/LoadSmoke.cs" Link="LoadSmoke.cs" />
    <Compile Include="../Common/ValidationSmoke.cs" Link="ValidationSmoke.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneCrypto/OneCrypto.csproj" />
  </ItemGroup>

</Project>
