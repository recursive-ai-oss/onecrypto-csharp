<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests deliberately call blocking and token-defaulted APIs of the library under test. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Linq" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Primitives/Data/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fuzz target body doubles as a deterministic mutation smoke test. -->
    <Compile Include="../../fuzz/OneCrypto.Fuzz/CmsTarget.cs" Link="Cms/CmsTarget.cs" />
    <Compile Include="../../fuzz/OneCrypto.Fuzz/X509Target.cs" Link="X509/X509Target.cs" />
    <Compile Include="../../fuzz/OneCrypto.Fuzz/PkcsTargets.cs" Link="Pkcs/PkcsTargets.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneCrypto/OneCrypto.csproj" />
  </ItemGroup>

</Project>
