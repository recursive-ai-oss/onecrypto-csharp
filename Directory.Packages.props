<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Family library the PDF bridge builds on (a published version, never a project reference). -->
    <PackageVersion Include="RecursiveAI.OnePdf" Version="1.16.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test, benchmark and fuzz projects only. The shipped packages reference nothing outside the shared framework. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="SharpFuzz" Version="2.2.0" />
    <!-- Comparators for the benchmarks: restored and run as black boxes, only from bench/. NSec is native-backed (reported, not gating). -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>
</Project>
